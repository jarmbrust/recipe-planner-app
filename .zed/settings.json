{
  "prettier": {
    "allowed": false,
  },
  "language_servers": [
    "!prettier",
    "..."
  ],
  "lsp": {
    "eslint": {
      "settings": {
        "configFile": "~/.nuxt/eslint.config.mjs",
      },
    },
    "tailwindcss-language-server": {
      "settings": {
        "tailwindCSS": {
          "lint": {
            "cssConflict": "ignore"
          }
        }
      }
    }
  },
  "format_on_save": "on",
  "languages": {
    "JavaScript": {
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
      },
    },
    "Vue.js": {
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
      },
    },
    "TypeScript": {
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
      },
    },
  },
}
